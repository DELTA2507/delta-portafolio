---
import SectionContainer from "../components/SectionContainer.astro";
import AnimatedHeading from "../components/AnimatedHeading";
import Trending from "../components/Trending.astro";
import { featuredArticles } from "../data/featuredArticles";

const articlePages = import.meta.glob("../content/articles/*.md", { eager: true });
const articles = Object.values(articlePages).map((file: any) => file.frontmatter);
---

<SectionContainer id="articles" class="bg-surface">
  <AnimatedHeading
    eyebrow="ARTÍCULOS DESTACADOS"
    title="Blog"
    description="Una selección de ideas, experiencias y conocimientos que quiero compartir."
    icon="blog"
    client:load
  />

  <Trending
    type="article"
    items={articles}
    featured={featuredArticles}
    href="/blog"
    ctaText="Ver todos los artículos"
  />
</SectionContainer>