---
import SectionContainer from "../components/SectionContainer.astro";
import AnimatedStaggeredContainerExperience from "../components/AnimatedStaggeredContainerExperience";
import AnimatedHeading from "../components/AnimatedHeading";
import experience from "../data/experience";
---

<SectionContainer id="experience" class="bg-surface">
	<AnimatedHeading
		eyebrow="TRAYECTORIA PROFESIONAL"
		title="Experiencia"
		description="Un recorrido por mi experiencia laboral y profesional."
		icon="experience"
		client:load
	/>

	<AnimatedStaggeredContainerExperience
		experience={experience}
		client:load
	/>
</SectionContainer>
