---
import AnimatedHeading from "../components/AnimatedHeading.tsx";
import ContactForm from "../components/ContactForm.tsx";
import SectionContainer from "../components/SectionContainer.astro";
---

<SectionContainer id="contact">
	<AnimatedHeading
		eyebrow="TRABAJEMOS JUNTOS"
		title="Contacto"
		description="¿Tenés alguna pregunta? Hablemos."
		icon="contact"
		client:load
	/>

	<div class="grid grid-cols-1 items-center gap-10 md:grid-cols-[0.9fr_1.1fr] md:gap-14 lg:gap-20">
		<p class="m-0 border-s-2 border-accent ps-6 text-heading leading-snug text-text md:text-title md:leading-snug">
			¿Tenés una <span class="font-semibold text-accent">idea</span>?
			<br />
			¿Un <span class="font-semibold text-accent">Proyecto en Mente</span>?
			<br />
			¿Necesitás una <span class="font-semibold text-accent">Página Web</span>?
		</p>

		<ContactForm client:load />
	</div>
</SectionContainer>