---
import { Image } from "astro:assets";
import { FaLinkedinIn } from "react-icons/fa";
import { SiGithub } from "react-icons/si";
import Eyebrow from "../components/Eyebrow";
import devPhoto from "../assets/dev-photo.jpg";

const notch = "[clip-path:polygon(0_0,100%_0,100%_70%,90%_100%,0_100%)]";
const photoClip = "polygon(0 0, 100% 0, 100% 82%, 82% 100%, 0 100%)";
---

<section id="hero" class="container-element flex min-h-svh items-center">
	<div class="mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-12 px-5 pt-28 pb-16 sm:px-8 md:grid-cols-[1.1fr_0.9fr] md:gap-14 md:pt-24 lg:px-10">

		<div class="order-2 flex flex-col items-start gap-6 md:order-1 md:gap-7">
			<div class="flex items-center gap-3">
				<span class="h-[2px] w-5 bg-accent"></span>
				<Eyebrow>Desarrollador Web · Ingeniero de Software</Eyebrow>
			</div>

			<h1 class="m-0 text-display font-semibold tracking-tight text-text sm:text-[3.5rem] md:text-[4rem] lg:text-[4.5rem]">
				Joseph Ugalde<br class="hidden sm:block" /> Murillo
			</h1>

			<p class="m-0 max-w-[48ch] text-base leading-relaxed text-text-muted sm:text-lg">
				Desarrollador web e ingeniero de software costarricense. Especializado en el desarrollo de páginas y aplicaciones web modernas, con un enfoque en la experiencia del usuario y el rendimiento. Siempre buscando aprender nuevas tecnologías y mejorar mis habilidades.
			</p>

			<div class="flex flex-wrap items-center gap-3 pt-2">
				<a
					href="mailto:joseph@example.com?subject=Nuevo%20proyecto%20web&body=Hola%20Joseph,%20tengo%20un%20sitio%20que%20quiero%20desarrollar."
					class:list={[
						"inline-flex items-center bg-accent px-6 py-2.5 text-sm font-semibold text-accent-contrast transition-all hover:brightness-110",
						notch,
					]}
				>
					Contáctame
				</a>

				<a
					href="https://www.linkedin.com/in/joseph-ugalde-murillo-0b4b4227a/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="LinkedIn"
					class:list={[
						"group inline-block bg-surface p-[1.5px] transition-colors hover:bg-[#0A66C2]",
						notch,
					]}
				>
					<span class:list={["flex items-center justify-center bg-background px-5 py-2.5", notch]}>
						<span class="flex items-center gap-2 text-sm font-medium text-text-muted transition-colors group-hover:text-[#0A66C2]">
							<FaLinkedinIn size={18} color="currentColor" />
							LinkedIn
						</span>
					</span>
				</a>

				<a
					href="https://github.com/DELTA2507"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="GitHub"
					class:list={[
						"group inline-block bg-surface p-[1.5px] transition-colors hover:bg-text",
						notch,
					]}
				>
					<span class:list={["flex items-center justify-center bg-background px-5 py-2.5", notch]}>
						<span class="flex items-center gap-2 text-sm font-medium text-text-muted transition-colors group-hover:text-text">
							<SiGithub size={18} color="currentColor" />
							GitHub
						</span>
					</span>
				</a>
			</div>

			<a
				href="https://ko-fi.com/J7N6224Z9A"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex transition-transform duration-300 hover:scale-105"
			>
				<img
					height="36"
					style="height:36px;"
					src="https://storage.ko-fi.com/cdn/kofi6.png?v=6"
					alt="Buy Me a Coffee at ko-fi.com"
				/>
			</a>
		</div>

		<div class="relative order-1 mx-auto aspect-square w-[70%] max-w-[260px] md:order-2 md:mx-0 md:w-full md:max-w-[360px] md:justify-self-end lg:max-w-[400px]">
			<div
				class="absolute inset-0 translate-x-3 translate-y-3 bg-accent"
				style={`clip-path: ${photoClip};`}
			></div>

			<div class="relative h-full w-full bg-surface p-[3px]" style={`clip-path: ${photoClip};`}>
				<div class="h-full w-full overflow-hidden bg-background" style={`clip-path: ${photoClip};`}>
					<Image
						src={devPhoto}
						alt="Joseph Ugalde Murillo"
						class="h-full w-full object-cover"
						loading="eager"
					/>
				</div>
			</div>

			<div class="pointer-events-none absolute -top-3 -left-3 h-8 w-8 border-t-2 border-l-2 border-accent"></div>
		</div>
	</div>
</section>