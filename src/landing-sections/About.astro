---
import AnimatedHeading from "../components/AnimatedHeading.tsx";
import AboutCard from "../components/AboutCard.tsx";
import SectionContainer from "../components/SectionContainer.astro";
---

<SectionContainer id="about">
	<AnimatedHeading
		eyebrow="CONOCE CÓMO TRABAJO"
		title="Acerca de mí"
		description="Mi enfoque, filosofía y fortalezas, y el valor que puedo aportar a cada proyecto."
		icon="about"
		client:load
	/>

	<div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
		<AboutCard
			eyebrow="Filosofía"
			title="Diseño con intención."
			description="Cada decisión debe tener un propósito. Busco crear soluciones claras, intuitivas y sostenibles, donde el diseño y la tecnología trabajen juntos en lugar de competir."
		/>

		<AboutCard
			eyebrow="Especialidad"
			title="Experiencias que funcionan."
			description="Desarrollo interfaces modernas y sistemas web enfocados en rendimiento, usabilidad y una experiencia que se sienta tan bien como funciona."
		/>

		<AboutCard
			eyebrow="Mentalidad"
			title="Siempre hay una mejor solución."
			description="No me conformo con hacer que algo funcione. Busco entender el problema, cuestionar lo innecesario y encontrar soluciones que sean simples, eficientes y fáciles de mantener."
		/>

		<AboutCard
			eyebrow="En un equipo"
			title="Aporto criterio, no solo código."
			description="Puedo involucrarme desde la idea hasta la implementación, aportar criterio técnico y de producto, y convertir problemas complejos en soluciones que el equipo pueda construir y mantener."
		/>
	</div>
</SectionContainer>