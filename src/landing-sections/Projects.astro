---
import SectionContainer from "../components/SectionContainer.astro";
import AnimatedHeading from "../components/AnimatedHeading";
import Trending from "../components/Trending.astro";
import { featuredProjects } from "../data/featuredProjects";

const projectPages = import.meta.glob("../content/projects/*.md", { eager: true });
const projects = Object.values(projectPages).map((file: any) => file.frontmatter);
---

<SectionContainer id="projects">
  <AnimatedHeading
    eyebrow="TRABAJOS DESTACADOS"
    title="Proyectos"
    description="Una selección de proyectos que representa lo que puedo construir."
    icon="projects"
    client:load
  />

  <Trending
    type="project"
    items={projects}
    featured={featuredProjects}
    href="/projects"
    ctaText="Ver todos los proyectos"
  />
</SectionContainer>