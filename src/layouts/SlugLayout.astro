---
import '../../src/styles/global.css'
import '../../src/styles/markdown-content.css'
import '../../src/styles/slug-layout.css'
import Navbar from '../components/Navbar';
import Footer from '../landing-sections/Footer.astro';

const { title = "Portafolio Joseph UM | Desarrollador Web e Ingeniero de Software" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link
			rel="preload"
			href="/Inter-Variable.ttf"
			as="font"
			type="font/ttf"
			crossorigin
		/>
		<link
			rel="preload"
			href="/JetBrainsMono-Variable.ttf"
			as="font"
			type="font/ttf"
			crossorigin
		/>
    <title>{title}</title>
  </head>
  <body>
    <Navbar pathname={Astro.url.pathname} client:load />
    <slot />
    <Footer />
  </body>
</html>