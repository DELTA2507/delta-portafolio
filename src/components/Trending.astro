---
import { ArrowRight } from "@lucide/astro";

interface Props {
  items: any[];
  featured: string[];
  href?: string;
  ctaText?: string;
  type?: "project" | "article";
}

const {
  items,
  featured,
  href,
  ctaText = "Ver todos",
  type = "project",
} = Astro.props;

// Máximo 4 destacados: 1 grande + 1 ancho + 2 pequeños
const featuredItems = featured
  .slice(0, 4)
  .map((slug) => items.find((item) => item.slug === slug))
  .filter(Boolean);

function getCardClasses(index: number) {
  if (index === 0) {
    return "min-h-[320px] md:col-span-2 md:min-h-[380px] lg:row-span-2 lg:min-h-0";
  }
  if (index === 1) {
    return "min-h-[260px] md:col-span-2";
  }
  return "min-h-[260px]";
}

function getTitleClasses(index: number) {
  return index === 0 ? "text-title" : "text-heading";
}
---

{featuredItems.length > 0 && (
  <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6 lg:grid-cols-4 lg:auto-rows-[minmax(250px,auto)]">
    {featuredItems.map((item, index) => (
      <a
        href={`/${type === "project" ? "project" : "blog"}/${item.slug}`}
        class:list={[
          "group relative isolate overflow-hidden rounded-2xl border border-border bg-surface",
          getCardClasses(index),
        ]}
      >
        <img
          src={type === "project" ? item.images?.[0] : item.cover}
          alt=""
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />

        {/* Gradiente solo en la parte baja: la imagen se ve limpia arriba */}
        <div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/35 via-45% to-transparent" />

        <div class="absolute inset-x-0 bottom-0 flex flex-col gap-3 p-5 sm:p-6 lg:p-7">
          <h3 class:list={["m-0 font-semibold tracking-tight text-white", getTitleClasses(index)]}>
            {item.title}
          </h3>

          {index === 0 && (
            <p class="m-0 max-w-[52ch] text-sm leading-relaxed text-white/80 line-clamp-2 sm:text-base">
              {item.shortDescription ?? item.summary}
            </p>
          )}

          {type === "project" && item.stack?.length > 0 && (
            <div class="flex flex-wrap items-center gap-2.5">
              {item.stack.map((stackIcon: string) => (
                <img
                  src={`/stack-icons/${stackIcon}.svg`}
                  alt={stackIcon}
                  title={stackIcon}
                  loading="lazy"
                  class="size-7 rounded-sm object-contain"
                />
              ))}
            </div>
          )}
        </div>
      </a>
    ))}
  </div>
)}

{href && (
  <div class="mt-10 flex justify-center">
    <a
      href={href}
      class="inline-flex items-center gap-2 rounded-xl bg-accent px-6 py-3 font-semibold text-accent-contrast transition-all hover:brightness-110"
    >
      {ctaText}
      <ArrowRight size={18} aria-hidden="true" />
    </a>
  </div>
)}