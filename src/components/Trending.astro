---
import { ArrowRight } from "@lucide/astro";

interface Props {
  items: any[];
  featured: string[];
  href?: string;
  ctaText?: string;
  type?: "project" | "article";
}

const {
  items,
  featured,
  href,
  ctaText = "Ver todos",
  type = "project",
} = Astro.props;

// Máximo 4 destacados: 1 grande + 1 segundo destacado + 2 pequeños
const featuredItems = featured
  .slice(0, 4)
  .map((slug) => items.find((item) => item.slug === slug))
  .filter(Boolean);

function getCardClasses(index: number) {
  if (index === 0) {
    // Grande: ocupa 2 columnas x 2 filas
    return "lg:col-span-2 lg:row-span-2 min-h-[500px]";
  }
  if (index === 1) {
    // Segundo destacado: ocupa 2 columnas, 1 fila (mismo ancho que los 2 pequeños juntos)
    return "lg:col-span-2 lg:row-span-1 min-h-[240px]";
  }
  // Pequeños: 1 columna cada uno
  return "lg:col-span-1 lg:row-span-1 min-h-[240px]";
}

function getTitleClasses(index: number) {
  if (index === 0) return "text-4xl";
  if (index === 1) return "text-3xl";
  return "text-2xl";
}
---

{featuredItems.length > 0 && (
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    {featuredItems.map((item, index) => (
      <a
        href={`/${type === "project" ? "project" : "blog"}/${item.slug}`}
        class:list={[
          "group relative overflow-hidden rounded-2xl border border-border bg-surface",
          getCardClasses(index),
        ]}
      >
        <img
          src={type === "project" ? item.images?.[0] : item.cover}
          alt={item.title}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />

        <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/30 to-transparent" />

        <div class="absolute inset-x-0 bottom-0 p-6">
          <h3 class:list={["font-bold text-white", getTitleClasses(index)]}>
            {item.title}
          </h3>

          {type === "project" && item.stack?.length > 0 && (
            <div class="flex gap-2 mt-3">
              {item.stack.map((stackIcon: string) => (
                <img
                  src={`/stack-icons/${stackIcon}.svg`}
                  alt={stackIcon}
                  class="w-7 h-7 rounded-sm transition-transform duration-300 group-hover:scale-105"
                />
              ))}
            </div>
          )}

          {index === 0 && (
            <p class="mt-2 text-sm text-white/70 line-clamp-2">
              {item.shortDescription ?? item.summary}
            </p>
          )}
        </div>
      </a>
    ))}
  </div>
)}

{href && (
  <div class="flex justify-center mt-8">
    <a
      href={href}
      class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-accent text-white font-semibold hover:brightness-110 transition-all"
    >
      {ctaText}
      <ArrowRight size={18} aria-hidden="true" />
    </a>
  </div>
)}