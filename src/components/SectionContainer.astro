---
interface Props {
	id?: string;
	class?: string;
	narrow?: boolean;
}

const { id, class: className = "", narrow = false } = Astro.props;
---

<section
	id={id}
	class:list={["scroll-mt-20 border-t border-border", className]}
>
	<div
		class:list={[
			"mx-auto w-full px-5 sm:px-8 lg:px-10 py-section",
			narrow ? "max-w-4xl" : "max-w-6xl",
		]}
	>
		<slot />
	</div>
</section>