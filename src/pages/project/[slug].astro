---
import { ExternalLink } from "@lucide/astro";
import ProjectSlugLayout from '../../layouts/SlugLayout.astro';
import Carousel from '../../components/Carousel';
import Breadcrumbs from '../../components/Breadcrumbs';
import TableOfContents from '../../components/TableOfContents';

export async function getStaticPaths() {
  const projectPages = import.meta.glob('../../content/projects/*.md', { eager: true });

  return Object.values(projectPages).map((file: any) => ({
    params: { slug: file.frontmatter.slug }
  }));
}

const { slug } = Astro.params;

const projectPages = import.meta.glob('../../content/projects/*.md', { eager: true });
const file = projectPages[`../../content/projects/${slug}.md`] as any;

if (!file) throw new Error(`Project content for slug "${slug}" not found`);

const { frontmatter, default: Content } = file as {
  frontmatter: {
    title: string;
    slug: string;
    images: string[];
    stack?: string[];
    link?: string;
    ownerLogo?: string;
    projectLogo?: string;
  };
  default: any;
};
---

<ProjectSlugLayout title={frontmatter.title}>
  <div class="mx-auto w-full max-w-6xl px-5 pt-28 pb-section sm:px-8 sm:pt-32 lg:px-10">

    <div class="mb-8 md:mb-10">
      <Breadcrumbs
        paths={[
          { name: "Inicio", href: "/" },
          { name: frontmatter.slug },
        ]}
      />
    </div>

    <div class="mb-10 flex items-start justify-between gap-6 md:mb-14">
      <h1 class="m-0 break-words text-title font-semibold tracking-tight text-text">
        {frontmatter.title}
      </h1>

      {frontmatter.ownerLogo && (
        <img
          class="size-12 shrink-0 rounded-lg object-contain sm:size-16"
          src={frontmatter.ownerLogo}
          alt="Owner Logo"
        />
      )}
    </div>

    <div class="project-detail-container grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-14 xl:grid-cols-[minmax(0,1fr)_22rem]">

      <div class="project-main flex min-w-0 flex-col gap-10 md:gap-12">

        <Carousel
          projectImages={frontmatter.images}
          client:load
        />

        <div class="project-cta flex flex-col gap-4 rounded-2xl border border-border bg-surface/80 p-5 backdrop-blur-xl lg:hidden">
          {frontmatter.link && (
            <a
              href={frontmatter.link}
              target="_blank"
              rel="noopener noreferrer"
              class="cta-link inline-flex items-center justify-center"
            >
              Visitar proyecto
              <ExternalLink size={18} class="ml-2" aria-hidden="true" />
            </a>
          )}
        </div>

        {frontmatter.stack && frontmatter.stack.length > 0 && (
          <section class="flex flex-col gap-5">
            <h2 class="m-0 scroll-mt-28 text-heading font-semibold text-text">
              Stack utilizado
            </h2>

            <div class="project-stack flex flex-wrap items-center gap-x-5 gap-y-4 rounded-2xl border border-border bg-surface/80 p-5 backdrop-blur-xl sm:p-6">
              {frontmatter.stack.map((stackIcon) => (
                <img
                  class="size-9 object-contain sm:size-10"
                  src={`/stack-icons/${stackIcon}.svg`}
                  alt={stackIcon}
                  title={stackIcon}
                  loading="lazy"
                />
              ))}
            </div>
          </section>
        )}

        <div class="markdown-content prose prose-invert max-w-[68ch] text-base leading-relaxed sm:text-lg [&_h2]:scroll-mt-28 [&_h3]:scroll-mt-28">
          <Content />
        </div>
      </div>

      <aside class="project-sidebar hidden lg:block">
        <div class="flex flex-col gap-6 lg:sticky lg:top-28">

          {frontmatter.projectLogo && (
            <div class="project-logo overflow-hidden rounded-xl">
              <img
                class="block h-auto w-full"
                src={frontmatter.projectLogo}
                alt="Project Logo"
              />
            </div>
          )}

          <div class="project-cta flex flex-col gap-4 rounded-2xl border border-border bg-surface/80 p-5 backdrop-blur-xl">
            {frontmatter.link && (
              <a
                href={frontmatter.link}
                target="_blank"
                rel="noopener noreferrer"
                class="cta-link inline-flex items-center justify-center"
              >
                Visitar proyecto
                <ExternalLink size={18} class="ml-2" aria-hidden="true" />
              </a>
            )}
          </div>

          <TableOfContents client:load />

        </div>
      </aside>

    </div>
  </div>
</ProjectSlugLayout>