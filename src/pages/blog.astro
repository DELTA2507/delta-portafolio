---
import Layout from "../layouts/Layout.astro";
import Trending from "../components/Trending.astro";
import FilterableCards from "../components/FilterableCards";
import AnimatedHeading from "../components/AnimatedHeading";
import { featuredArticles } from "../data/featuredArticles";

const articlePages = import.meta.glob("../content/articles/*.md", { eager: true });
const articles = Object.values(articlePages).map((file: any) => file.frontmatter);
---

<Layout>
  <main class="mx-auto w-full max-w-6xl px-5 pt-28 pb-section sm:px-8 sm:pt-32 lg:px-10">
    <AnimatedHeading
      as="h1"
      eyebrow="BLOG"
      title="Ideas, tecnología y desarrollo"
      description="Artículos sobre desarrollo de software, diseño, tecnología y las cosas que voy aprendiendo en el camino."
      icon="blog"
      client:load
    />

    <Trending
      type="article"
      items={articles}
      featured={featuredArticles}
    />

    <section class="mt-section border-t border-border pt-12 md:pt-16">
      <div class="mb-10 md:mb-12">
        <p class="mb-3 font-mono text-eyebrow uppercase tracking-[0.14em] text-accent">
          Archivo
        </p>

        <h2 class="m-0 text-title font-semibold tracking-tight text-text">
          Más artículos
        </h2>

        <p class="mt-4 mb-0 max-w-[52ch] text-base leading-relaxed text-text-muted">
          Explora todos los artículos publicados.
        </p>
      </div>

      <FilterableCards type="article" items={articles} client:load />
    </section>
  </main>
</Layout>