---
import Layout from "../layouts/Layout.astro";
import Trending from "../components/Trending.astro";
import AnimatedStaggeredContainerCards from "../components/AnimatedStaggeredContainerCards";
import { featuredArticles } from "../data/featuredArticles";

const articlePages = import.meta.glob("../content/articles/*.md", { eager: true });
const articles = Object.values(articlePages).map((file: any) => file.frontmatter);
---

<Layout>
  <main class="max-w-7xl mx-auto px-4 py-12">
    <header class="mb-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">
        Blog
      </p>

      <h1 class="mt-2 text-5xl font-bold text-text">
        Ideas, tecnología y desarrollo
      </h1>

      <p class="mt-4 max-w-2xl text-lg text-text-muted">
        Artículos sobre desarrollo de software, diseño, tecnología y las cosas
        que voy aprendiendo en el camino.
      </p>
    </header>

    <Trending
      type="article"
      items={articles}
      featured={featuredArticles}
    />

    <section class="mt-16 pt-10 border-t border-border">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-8">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">
            Archivo
          </p>

          <h2 class="mt-1 text-3xl font-bold text-text">
            Más artículos
          </h2>

          <p class="mt-2 text-text-muted">
            Explora todos los artículos publicados.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            class="px-4 py-2 rounded-lg bg-surface border border-border text-text text-sm font-medium"
          >
            Todos
          </button>

          <button
            type="button"
            class="px-4 py-2 rounded-lg bg-surface border border-border text-text-muted text-sm font-medium hover:text-text transition-colors"
          >
            Desarrollo
          </button>

          <button
            type="button"
            class="px-4 py-2 rounded-lg bg-surface border border-border text-text-muted text-sm font-medium hover:text-text transition-colors"
          >
            Tecnología
          </button>
        </div>
      </div>

      <AnimatedStaggeredContainerCards
        articles={articles}
        client:load
      />
    </section>
  </main>
</Layout>