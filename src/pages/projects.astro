---
import Layout from "../layouts/Layout.astro";
import Trending from "../components/Trending.astro";
import AnimatedStaggeredContainerCards from "../components/AnimatedStaggeredContainerCards";
import { featuredProjects } from "../data/featuredProjects";

const projectPages = import.meta.glob("../content/projects/*.md", { eager: true });
const projects = Object.values(projectPages).map((file: any) => file.frontmatter);

const remainingProjects = projects.filter(
  (project) => !featuredProjects.includes(project.slug)
);
---

<Layout>
  <main class="max-w-7xl mx-auto px-4 py-12">
    <header class="mb-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">
        Proyectos
      </p>

      <h1 class="mt-2 text-5xl font-bold text-text">
        Lo que he construido
      </h1>

      <p class="mt-4 max-w-2xl text-lg text-text-muted">
        Una selección de proyectos destacados y trabajos que representan mi
        forma de desarrollar productos digitales.
      </p>
    </header>

    <Trending
      type="project"
      items={projects}
      featured={featuredProjects}
    />

    <section class="mt-20 pt-12 border-t border-border">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">
            Catálogo
          </p>

          <h2 class="mt-2 text-4xl font-bold text-text">
            Más proyectos
          </h2>

          <p class="mt-3 max-w-xl text-text-muted">
            Explora el resto de mis proyectos, experimentos y trabajos.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            class="px-4 py-2 rounded-lg bg-accent text-white text-sm font-medium"
          >
            Todos
          </button>

          <button
            type="button"
            class="px-4 py-2 rounded-lg bg-surface border border-border text-text-muted text-sm font-medium hover:text-text hover:border-accent transition-colors"
          >
            Web
          </button>

          <button
            type="button"
            class="px-4 py-2 rounded-lg bg-surface border border-border text-text-muted text-sm font-medium hover:text-text hover:border-accent transition-colors"
          >
            Apps
          </button>

          <button
            type="button"
            class="px-4 py-2 rounded-lg bg-surface border border-border text-text-muted text-sm font-medium hover:text-text hover:border-accent transition-colors"
          >
            Otros
          </button>
        </div>
      </div>

      <AnimatedStaggeredContainerCards
        projects={remainingProjects}
        client:load
      />
    </section>
  </main>
</Layout>