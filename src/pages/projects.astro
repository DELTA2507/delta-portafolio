---
import Layout from "../layouts/Layout.astro";
import Trending from "../components/Trending.astro";
import FilterableCards from "../components/FilterableCards";
import AnimatedHeading from "../components/AnimatedHeading";
import { featuredProjects } from "../data/featuredProjects";

const projectPages = import.meta.glob("../content/projects/*.md", { eager: true });
const projects = Object.values(projectPages).map((file: any) => file.frontmatter);

const remainingProjects = projects.filter(
  (project) => !featuredProjects.includes(project.slug)
);
---

<Layout>
  <main class="mx-auto w-full max-w-6xl px-5 pt-28 pb-section sm:px-8 sm:pt-32 lg:px-10">
    <AnimatedHeading
      as="h1"
      eyebrow="PROYECTOS"
      title="Lo que he construido"
      description="Una selección de proyectos destacados y trabajos que representan mi forma de desarrollar productos digitales."
      icon="projects"
      client:load
    />

    <Trending
      type="project"
      items={projects}
      featured={featuredProjects}
    />

    <section class="mt-section border-t border-border pt-12 md:pt-16">
      <div class="mb-10 md:mb-12">
        <p class="mb-3 font-mono text-eyebrow uppercase tracking-[0.14em] text-accent">
          Catálogo
        </p>

        <h2 class="m-0 text-title font-semibold tracking-tight text-text">
          Más proyectos
        </h2>

        <p class="mt-4 mb-0 max-w-[52ch] text-base leading-relaxed text-text-muted">
          Explora el resto de mis proyectos, experimentos y trabajos.
        </p>
      </div>

      <FilterableCards type="project" items={remainingProjects} client:load />
    </section>
  </main>
</Layout>